# ---- LLM (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, DeepSeek, Together, vLLM...) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Strong model: writes the final answer (streamed) and may call web_search.
LLM_MODEL=gpt-4.1
# Small/fast model: routing, query planning, summaries, topic extraction. Defaults to LLM_MODEL if empty.
LLM_FAST_MODEL=gpt-4.1-mini
# Optional extra JSON merged into every request body for that model, e.g. OpenRouter reasoning control: {"reasoning":{"effort":"low"}}
LLM_EXTRA_BODY=
LLM_FAST_EXTRA_BODY=
# Optional: put the fast model on a different provider (e.g. Groq). Empty = reuse LLM_BASE_URL / LLM_API_KEY.
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=

# ---- Search (the agent's single tool: web_search) ----
# Primary provider: tavily | brave | exa
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional fallback, used automatically if the primary errors or returns nothing.
SEARCH_FALLBACK_PROVIDER=brave
BRAVE_API_KEY=
EXA_API_KEY=

# ---- App ----
PORT=3000
USER_TZ=Asia/Kolkata
DB_PATH=./data/minimi.db
# Search cache TTL in seconds (news / "latest" queries use a shorter TTL automatically).
SEARCH_CACHE_TTL=21600
# Set to 1 to run with deterministic fake LLM + search (no keys needed; used by tests and offline demos).
MOCK_PROVIDERS=
# Optional: pin "now" (ISO string) for demos/tests, e.g. 2026-11-10T14:00:00+05:30
NOW_OVERRIDE=
# Demo conversations (CRM shortlist, Postgres hosting, ...) are inserted into an EMPTY database on first start. 0 = don't.
SEED_DEMO=1
